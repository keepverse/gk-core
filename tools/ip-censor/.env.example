# ip-censor local model settings (ipcensor.llm.load_config), mirroring seedsmith's keys.
#
# Copy this file to `.env` in this directory and edit — `.env` is gitignored (the repo root
# .gitignore's bare `.env` pattern) so machine-specific endpoints and models never get committed.
# Every key here overrides the committed default, which overrides the built-in default; an unset key
# falls through to the next layer. Never a silent hardcode.
#
# `--authored-only` never reads any of these and never needs a network; that is the CI-safe mode
# and the one the release gate uses (the gate needs no model at all — spec-wiring.md).

# The local OpenAI-compatible endpoint (LM Studio default shown).
IPCENSOR_LLM_ENDPOINT=http://localhost:1234/v1/chat/completions

# Which loaded model to call — must match an id the endpoint reports at /v1/models.
IPCENSOR_LLM_MODEL=google/gemma-4-26b-a4b-qat

# Seconds to wait for one call before giving up.
IPCENSOR_LLM_TIMEOUT=420

# Retry attempts on a transport failure (timeout/connection error), not a content defect.
IPCENSOR_LLM_ATTEMPTS=2

# Seconds to wait between transport-failure retries.
IPCENSOR_LLM_RETRY_DELAY=3
