<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release-only harness: a benchmark built in Debug measures the JIT, not the code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FusionRpg.Core\FusionRpg.Core.csproj" />
    <!-- world-graph-diff (base-defense 3.1): an isolated SQLite harness, not a reference to
         FusionRpg.Data; see WorldGraphWriteBench.cs's own doc comment for why. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
