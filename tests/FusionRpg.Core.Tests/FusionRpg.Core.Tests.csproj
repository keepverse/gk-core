<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\FusionRpg.Core.Tests.Shared\CoreTests.Shared.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FusionRpg.Core.Tests</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FusionRpg.Core\FusionRpg.Core.csproj" />
    <!-- The shared bridge types are a real assembly now, not sources compiled in from the host
         repository. See src/FusionRpg.Bridge/FusionRpg.Bridge.csproj. -->
    <ProjectReference Include="..\..\src\FusionRpg.Bridge\FusionRpg.Bridge.csproj" />
    <!-- creature-seed module 1 (spec-corpus-dump.md) puts CorpusDumpTests.cs here, and its fixture
         is a small in-memory RpgStore rather than the 520MB live database — so this test project
         needs the DAL and the tool's own writer/reader, same shape FusionRpg.Data.Tests already
         has for RpgStore, just scoped to this one module. -->
    <ProjectReference Include="..\..\src\FusionRpg.Data\FusionRpg.Data.csproj" />
    <ProjectReference Include="$(GkForgeRoot)tools\CreatureCorpusDump\CreatureCorpusDump.csproj" />
    <!-- Cold-process tool fixtures (2026-09-12). Nine test classes shell out to these tools with a
         no-build Release invocation, but nothing ever built them: the tool bin folders are untracked
         and the test project did not reference them, so CI (and any clean clone) either ran a stale
         binary or found none. Two of them embed FusionRpg.Core, so a rename the source already
         carried (demonType to creatureType) survived in the 9/4 Release output and made the Balance
         tests throw `missing required key 'demonType'` — a binary-freshness defect, not a test bug.
         Referencing each tool makes `dotnet test` build it in the same configuration, so the
         no-build invocation finds a binary that matches the source. This mirrors the apphost
         convention FusionRpg.AtomImporter.Tests established for the same reason. -->
    <ProjectReference Include="$(GkForgeRoot)tools\DominanceBaseline\DominanceBaseline.csproj" />
    <ProjectReference Include="..\..\tools\ResidualFitLoop\ResidualFitLoop.csproj" />
    <ProjectReference Include="..\..\tools\RealDataAggregate\RealDataAggregate.csproj" />
    <ProjectReference Include="..\..\tools\CombatSim\CombatSim.csproj" />
    <ProjectReference Include="$(GkForgeRoot)tools\CreatureQualityReport\CreatureQualityReport.csproj" />
    <ProjectReference Include="..\..\tools\ProveAptitude\ProveAptitude.csproj" />
    <!-- ProvePredictor had no test that would notice it breaking until solid-remediation T1.8;
         referencing it here is what makes its apphost land beside the test dll, the same
         pattern CombatSim and ProveAptitude already use. -->
    <ProjectReference Include="..\..\tools\ProvePredictor\ProvePredictor.csproj" />
    <ProjectReference Include="$(GkForgeRoot)tools\CreatureSpeciesGen\CreatureSpeciesGen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- These have no Unity/Harmony/BepInEx deps (pure Core types only) — compile for unit tests
         rather than referencing FusionRpg.Injector.BepInEx, which needs the real game's interop
         DLLs (FUSIONRPG_GAME_DIR) to build at all. Same pattern as FusionRpg.Launcher.Tests' link
         of FileRpgConfig.cs. PatronAuraOverlay.cs itself was removed 2026-09-06 (patron-absorption,
         `seed-to-concrete` T6.2) — its combat math moved to the compiled-atom grant path. -->
    <Compile Include="..\FusionRpg.Data.Tests\DataTestStore.cs" Link="TestSupport\DataTestStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\effects\**\*" Link="fixtures\effects\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\combat\**\*" Link="fixtures\combat\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Goldens\actor-hud\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
